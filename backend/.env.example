PORT=5000
JWT_SECRET=replace_this_with_a_long_secret
# Optional in development: leave empty, use placeholders like <user>, or set USE_MEMORY_DB=true to use
# embedded in-memory MongoDB (data resets when the server stops).
# Local Docker: mongodb://127.0.0.1:27017/ecommerce
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/ecommerce?retryWrites=true&w=majority
MONGO_URI=
USE_MEMORY_DB=true
CLIENT_URL=http://localhost:5173
NODE_ENV=development
